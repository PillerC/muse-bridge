# Muse Bridge 配置。放到 /etc/muse-bridge.env，chmod 600。
# 所有项在启动时校验，缺一项进程就拒绝启动——不会带着半套配置跑。

# 数据目录：SQLite、证书缓存、日志
BRIDGE_DATA_DIR=/data/bridge-data

# 管理后台监听地址（只绑本机，用 SSH 隧道访问 http://127.0.0.1:8080）
BRIDGE_ADDR=127.0.0.1:8080

# 公网监听地址
BRIDGE_PUBLIC_ADDR=0.0.0.0:443
BRIDGE_PUBLIC_URL=https://bridge.example.com

# TLS：autocert 自动申请并续期 Let's Encrypt 证书（需要 80 端口可达）
BRIDGE_TLS=autocert
BRIDGE_ACME_EMAIL=you@example.com

# 管理员账号。改密码只要改这里再重启。
BRIDGE_ADMIN_USER=admin
BRIDGE_ADMIN_PASSWORD=change-me-please

# 加密机器人 token 的主密钥，32 字节的 base64。
# 生成：head -c 32 /dev/urandom | base64
# 换掉这个值会导致已有桥的 token 无法解密，必须重建。
BRIDGE_SECRET=

# 新桥默认收消息方式：webhook 或 poll
BRIDGE_MODE=webhook

# 访问 api.telegram.org 的 HTTP 代理，可留空
BRIDGE_TG_PROXY=
