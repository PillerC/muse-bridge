[Unit]
Description=Muse Telegram Poller (5s pull from Cloudflare Worker + D1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按实际路径改下面两行
WorkingDirectory=/opt/telegram-muse-bridge/muse-poller
ExecStart=/opt/telegram-muse-bridge/muse-poller/.venv/bin/python poller.py
EnvironmentFile=/opt/telegram-muse-bridge/muse-poller/.env
Restart=always
RestartSec=5
# 崩溃/超时后 systemd 自动拉起; 未 ack 的消息租约过期后自动回 pending, 不丢消息
KillSignal=SIGTERM
TimeoutStopSec=30
# 日志进 journald: journalctl -u muse-telegram-poller -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
