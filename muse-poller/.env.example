# 复制为 .env 并填好: cp .env.example .env
# 注意: .env 含密钥, 不要提交到 git, 不要发给别人

# --- Worker 队列 (必填) ---
WORKER_URL=https://telegram-queue.<your-subdomain>.workers.dev
POLLER_TOKEN=<与 wrangler secret put POLLER_TOKEN 相同的值>
POLL_INTERVAL=5
POLL_BATCH_SIZE=5
LEASE_SECONDS=180
MAX_CONCURRENT=3

# --- Telegram (必填) ---
BOT_TOKEN=<从 @BotFather 拿到的 token>
BOT_USERNAME=my_muse_bot
BOT_ID=<Bot 的数字 ID, 可选>

# --- Muse 后端 (三选一, 先用 echo 验证链路) ---
MUSE_BACKEND=echo
# MUSE_BACKEND=http 时填 VM 上 Muse webhook 地址 (SSE 流式, 约定见 muse_agent.py)
MUSE_WEBHOOK_URL=http://127.0.0.1:8080/chat
MUSE_HTTP_TIMEOUT=300
# MUSE_BACKEND=cli 时填本地命令, 如 muse --print
MUSE_CLI_CMD=
MUSE_CLI_TIMEOUT=300

# --- 流式渲染 ---
EDIT_THROTTLE_SEC=1.2
TYPING_INTERVAL_SEC=4.0

# --- 其他 ---
LOG_LEVEL=INFO
# 私聊也只回 @ /引用? 默认 false (私聊全回)
PRIVATE_REQUIRES_TRIGGER=false
