#!/sbin/openrc-run
# Muse Telegram Poller - Alpine / OpenRC 服务脚本
# (systemd 系统请用 muse-telegram-poller.service)
#
# 安装:
#   cp muse-telegram-poller.initd /etc/init.d/muse-telegram-poller
#   chmod +x /etc/init.d/muse-telegram-poller
#   rc-update add muse-telegram-poller default
#   rc-service muse-telegram-poller start
# 日志: tail -f /var/log/muse-telegram-poller.log

name="muse-telegram-poller"
description="Muse Telegram Poller (pulls from Cloudflare Worker + D1 every 5s)"

POLLER_DIR="/opt/telegram-muse-bridge/muse-poller"

# supervise-daemon: 崩溃自动重启 (对标 systemd Restart=always)
supervisor="supervise-daemon"
command="${POLLER_DIR}/.venv/bin/python"
command_args="${POLLER_DIR}/poller.py"
directory="${POLLER_DIR}"
pidfile="/run/muse-telegram-poller.pid"
output_log="/var/log/muse-telegram-poller.log"
error_log="/var/log/muse-telegram-poller.log"
respawn_delay=5

depend() {
    need net
    after firewall
}

start_pre() {
    # 把 .env 载入环境 (对标 systemd EnvironmentFile)
    if [ -f "${POLLER_DIR}/.env" ]; then
        set -a
        . "${POLLER_DIR}/.env"
        set +a
    else
        eerror ".env 不存在: ${POLLER_DIR}/.env"
        return 1
    fi
    checkpath --file --owner root:root --mode 0644 /var/log/muse-telegram-poller.log
}
